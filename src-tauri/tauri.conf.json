{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goob UI",
  "version": "1.1.1",
  "identifier": "com.cgwol.goob-ui",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Goob UI",
        "width": 1280,
        "height": 720,
        "fullscreen": false,
        "decorations": false,
        "maximized": false,
        "alwaysOnTop": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}